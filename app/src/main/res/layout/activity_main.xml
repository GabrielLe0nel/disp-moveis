
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <!-- Primeira linha: Ferramentas -->

    <Button
        android:id="@+id/btnFree"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="✏️ Livre"
        android:textSize="12sp"
        android:layout_margin="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnRect"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnRect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="▭ Retângulo"
        android:textSize="12sp"
        android:layout_margin="4dp"
        app:layout_constraintStart_toEndOf="@+id/btnFree"
        app:layout_constraintEnd_toStartOf="@+id/btnCircle"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnCircle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="⬤ Círculo"
        android:textSize="12sp"
        android:layout_margin="4dp"
        app:layout_constraintStart_toEndOf="@+id/btnRect"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Segunda linha: Cor e Limpar -->

    <Button
        android:id="@+id/btnColor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="🎨 Cor"
        android:textSize="13sp"
        android:layout_margin="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnClear"
        app:layout_constraintTop_toBottomOf="@+id/btnFree" />

    <Button
        android:id="@+id/btnClear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="🗑️ Limpar"
        android:textSize="13sp"
        android:backgroundTint="#E53935"
        android:layout_margin="4dp"
        app:layout_constraintStart_toEndOf="@+id/btnColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCircle" />

    <!-- Área de desenho -->

    <com.ifsc.app.SimplePaint
        android:id="@+id/simplePaint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F5F5F5"
        android:layout_margin="4dp"
        app:layout_constraintTop_toBottomOf="@+id/btnColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
